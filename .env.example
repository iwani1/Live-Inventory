# PostgreSQL connection string (required — src/db/index.ts throws without it)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# HMAC key used to sign the ember_session cookie. MUST be set in production.
SESSION_SECRET=replace-me-with-a-long-random-string

# Session cookie SameSite mode: "lax" (default, correct for a normal site) or
# "none" for cross-site iframe hosting (dev previews), which also turns on
# Secure + Partitioned. See src/lib/auth.ts.
# COOKIE_SAMESITE=none

# SANDBOX PREVIEW ONLY — never set this locally or in production.
# Signs every cookie-less request in as the given role, for browsers that
# refuse third-party cookies inside a cross-site iframe. Inert in production.
# DEMO_AUTOLOGIN=admin
